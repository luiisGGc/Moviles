--- !u!1 &1244105666
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 1244105668}
  - component: {fileID: 1244105667}
  m_Layer: 0
  m_Name: "GameManagerusing UnityEngine; using UnityEngine.Events; #if PLATFORM_ANDROID
    using UnityEngine.Android; #endif  public class FoodCooler : MonoBehaviour {    
    [Header(\"Configuraci\xF3n del Micr\xF3fono\")]     public float threshold =
    0.05f; // Nivel m\xEDnimo de volumen para que cuente como soplido     public
    int sampleWindow = 128; // Cantidad de muestras a analizar por frame     private
    AudioClip microphoneClip;     private string micName;      [Header(\"L\xF3gica
    del Microjuego (WarioWare)\")]     public float timeLimit = 4.0f; // Segundos
    antes de perder     public float requiredBlowTime = 1.5f; // Segundos de soplido
    continuo necesarios para ganar          private float currentBlowTime = 0f;    
    private float timer = 0f;     private bool gameOver = false;      [Header(\"Eventos
    Visuales (Inspector)\")]     public UnityEvent OnBlowing; // Se dispara mientras
    detecta el soplido (ej. reducir humo)     public UnityEvent OnStopBlowing; //
    Se dispara cuando deja de soplar     public UnityEvent OnGameWon; // Se dispara
    al enfriar la comida     public UnityEvent OnGameLost; // Se dispara si se acaba
    el tiempo      void Start()     {         // Solicitar permisos en Android        
    #if PLATFORM_ANDROID         if (!Permission.HasUserAuthorizedPermission(Permission.Microphone))        
    {             Permission.RequestUserPermission(Permission.Microphone);        
    }         #endif          // Iniciar el micr\xF3fono (null toma el predeterminado
    del celular)         if (Microphone.devices.Length > 0)         {            
    micName = Microphone.devices[0];             // Grabamos un clip continuo (loop
    = true) de 1 segundo a 44100 Hz             microphoneClip = Microphone.Start(micName,
    true, 1, 44100);         }         else         {             Debug.LogError(\"No
    se detect\xF3 ning\xFAn micr\xF3fono.\");         }     }      void Update()    
    {         if (gameOver) return;          // Temporizador global del microjuego        
    timer += Time.deltaTime;         if (timer >= timeLimit)         {            
    LoseGame();             return;         }          // Analizar el volumen actual        
    float currentVolume = GetRMSVolume();          if (currentVolume > threshold)        
    {             // El jugador est\xE1 soplando             currentBlowTime += Time.deltaTime;            
    OnBlowing.Invoke();              if (currentBlowTime >= requiredBlowTime)            
    {                 WinGame();             }         }         else         {            
    // El jugador dej\xF3 de soplar             OnStopBlowing.Invoke();            
    // Opcional: reducir currentBlowTime ligeramente si quieres que la sopa se vuelva
    a calentar             // currentBlowTime = Mathf.Max(0, currentBlowTime - Time.deltaTime);        
    }     }      // Calcula la ra\xEDz cuadrada media (RMS) de la ventana de audio    
    private float GetRMSVolume()     {         if (Microphone.GetPosition(micName)
    <= 0) return 0;          float[] waveData = new float[sampleWindow];        
    int micPosition = Microphone.GetPosition(micName) - (sampleWindow + 1);                 
    if (micPosition < 0) return 0;          microphoneClip.GetData(waveData, micPosition);         
    // Suma de los cuadrados         float sum = 0;         for (int i = 0; i < sampleWindow;
    i++)         {             sum += waveData[i] * waveData[i];         }         
    // Ra\xEDz cuadrada de la media         return Mathf.Sqrt(sum / sampleWindow);    
    }      private void WinGame()     {         gameOver = true;         Microphone.End(micName);        
    OnGameWon.Invoke();         Debug.Log(\"\xA1Comida enfriada! GANASTE.\");    
    }      private void LoseGame()     {         gameOver = true;         Microphone.End(micName);        
    OnGameLost.Invoke();         Debug.Log(\"\xA1La comida explot\xF3/quem\xF3! PERDISTE.\");    
    } }"
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
